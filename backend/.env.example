# ════════════════════════════════════════════════════════════════
#  La Délicieuse Diète — Variables d'environnement backend
#  Copier ce fichier en .env et remplir toutes les valeurs
# ════════════════════════════════════════════════════════════════

# ── Serveur ───────────────────────────────────────────────────────
PORT=3000
# En production : NODE_ENV=production. Le serveur refuse alors de démarrer si JWT_SECRET ou ADMIN_PASSWORD sont encore les valeurs d'exemple.
# Voir PRODUCTION.md à la racine du projet.
NODE_ENV=development

# ── URLs ──────────────────────────────────────────────────────────
# Plusieurs adresses possibles, séparées par des virgules (ex. avec et sans www) : toutes sont autorisées par CORS,
# la première sert aux liens des e-mails et aux retours de paiement.
FRONTEND_URL=http://localhost:5100

# ── Prix des commandes ────────────────────────────────────────────
# Les prix viennent d'un devis signé par le serveur. Laisser à false.
# true = accepte aussi les commandes SANS devis (anciens onglets pendant une mise en ligne) :
# tant que c'est true, les prix envoyés par le navigateur ne sont PAS contrôlés. À repasser à false aussitôt après.
ALLOW_UNQUOTED_ORDERS=false
BACKEND_URL=http://localhost:3000

# ── Base de données MongoDB ───────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/ladelicieuse

# ── JWT (générer avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_64_RANDOM_BYTES

# ── Admin ─────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@ladelicieuse.ga
ADMIN_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ── Redis / Upstash (optionnel — fallback mémoire si absent) ──────
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxx

# ── Email Gmail (activer "Mots de passe d'application" Google) ────
# SMTP_HOST=smtp.gmail.com   (par défaut)
# SMTP_PORT=465              (par défaut ; 587 pour STARTTLS)
EMAIL_USER=votre.adresse@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── SingPay (Maviance) ────────────────────────────────────────────
SINGPAY_API_BASE_URL=https://gateway.singpay.ga/v1
SINGPAY_API_KEY=votre_client_id_singpay
SINGPAY_API_SECRET=votre_client_secret_singpay
SINGPAY_WALLET_ID=votre_wallet_id
SINGPAY_DISBURSEMENT_ID=votre_disbursement_id
SINGPAY_WEBHOOK_SECRET=votre_webhook_secret_singpay

# ── WhatsApp (Meta WhatsApp Cloud API) ───────────────────────────
# 1. Allez sur developers.facebook.com → Créer une application → Ajouter le produit WhatsApp
# 2. Dans Paramètres WhatsApp → récupérez le Phone Number ID et le Token d'accès
META_WHATSAPP_TOKEN=votre_token_meta_whatsapp
META_PHONE_NUMBER_ID=votre_phone_number_id_meta

# Numéro WhatsApp de la boutique (pour les notifs internes)
WHATSAPP_STORE_PHONE=+24177000000

# ── Notifications Push (VAPID) ────────────────────────────────────
# Générer avec: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=votre_vapid_public_key
VAPID_PRIVATE_KEY=votre_vapid_private_key
VAPID_EMAIL=mailto:admin@ladelicieuse.ga
